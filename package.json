{
  "name": "doppelpunkt",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "services/*", "tools"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run content:build && npm run dev -w @doppelpunkt/web",
    "build": "npm run content:build && npm run build -w @doppelpunkt/web",
    "content:lint": "npm run lint -w @doppelpunkt/tools",
    "content:build": "npm run build-packs -w @doppelpunkt/tools",
    "content:report": "npm run report -w @doppelpunkt/tools",
    "book:build": "npm run book:build -w @doppelpunkt/tools --",
    "audio:scripts": "npm run audio:scripts -w @doppelpunkt/tools --",
    "audio:process": "npm run audio:process -w @doppelpunkt/tools --",
    "audio:link": "npm run audio:link -w @doppelpunkt/tools --",
    "audio:upload": "npm run audio:upload -w @doppelpunkt/tools --",
    "beta:report": "npm run beta:report -w @doppelpunkt/tools --",
    "beta:fixture": "npm run beta:fixture -w @doppelpunkt/tools --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @doppelpunkt/web"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.19.0"
  }
}
