// Doppelpunkt book template (Typst 0.13). The book sources in books/build/ are generated by
// `npm run book:build` (tools/src/book.ts) and import this file. Edit the design here; edit the
// words in content/. Colours match the app: gold = Standard German, red = Swiss German.

// ---------------------------------------------------------------------------------------------
// Tokens
// ---------------------------------------------------------------------------------------------

#let gold = rgb("#b07a12")
#let gold-soft = rgb("#f6ebcf")
#let gold-strong = rgb("#8a5e0a")
#let swiss = rgb("#c8281c")
#let swiss-soft = rgb("#f9dcd8")
#let swiss-strong = rgb("#9e1f15")
#let ink = rgb("#1d2433")
#let muted = rgb("#5b6475")
#let rule-c = rgb("#d5d9e0")
#let paper-tint = rgb("#f5f6f8")
// Noun genders: neither gold nor red, so they never read as a variety. The article is always
// printed as well, so the marking survives black-and-white printing.
#let gender-c = (m: rgb("#2b5ea8"), f: rgb("#8a3ea0"), n: rgb("#2e7d4f"))
#let article = (m: "der", f: "die", n: "das")

#let serif = ("Libertinus Serif", "New Computer Modern", "DejaVu Serif")
#let sans = ("Inter", "DejaVu Sans", "Liberation Sans", "Libertinus Serif")

// ---------------------------------------------------------------------------------------------
// Small pieces
// ---------------------------------------------------------------------------------------------

#let variety-label = (de: "DE", "ch-std": "CH", "gsw-zh": "ZH", "gsw-be": "BE")
#let variety-name = (
  de: "Standard German (Germany)",
  "ch-std": "Swiss Standard German",
  "gsw-zh": "Zurich German",
  "gsw-be": "Bernese German",
)
#let is-swiss(v) = v != "de"
#let accent(v) = if is-swiss(v) { swiss } else { gold }

/// The small DE / CH / ZH / BE badge the app shows as VarietyTag.
#let vtag(v) = box(
  baseline: 12%,
  inset: (x: 1.8pt, y: 1.4pt),
  radius: 1.5pt,
  stroke: 0.4pt + accent(v).lighten(30%),
  fill: if is-swiss(v) { swiss-soft } else { gold-soft },
  text(font: sans, size: 5.2pt, weight: "bold", tracking: 0.3pt,
    fill: if is-swiss(v) { swiss-strong } else { gold-strong }, variety-label.at(v)),
)

/// German text in the right language (hyphenation, quotes), with its variety tag in front.
#let de(v, body) = {
  vtag(v)
  h(2.5pt)
  if v == "de" { text(lang: "de", body) } else { text(lang: "de", region: "CH", body) }
}
/// German text without a tag (inside an item that is already tagged).
#let deu(v, body) = if v == "de" { text(lang: "de", body) } else { text(lang: "de", region: "CH", body) }

#let en(body) = text(fill: muted, style: "italic", body)

/// Audio track reference. The audio itself is in the app; the transcript only in the answer key.
#let track(id) = box(baseline: 15%, inset: (x: 3pt, y: 1.6pt), radius: 6pt, fill: ink,
  text(font: sans, size: 6.5pt, weight: "bold", fill: white)[
    #box(width: 4.2pt, height: 5pt, baseline: 0pt, polygon(fill: white, (0pt, 0pt), (4.2pt, 2.5pt), (0pt, 5pt)))
    #h(1.5pt)Track #id
  ])

#let checkbox = box(width: 7pt, height: 7pt, baseline: 1pt, stroke: 0.6pt + ink, radius: 1pt)
#let circle-box = box(width: 7.5pt, height: 7.5pt, baseline: 1pt, circle(radius: 3.75pt, stroke: 0.6pt + ink))

/// A writing gap: a line about as long as the model answer (`chars`), optionally numbered.
#let gap(chars, n: none) = {
  if n != none { text(font: sans, size: 6pt, fill: muted, super(str(n))) }
  box(width: calc.max(2.6, chars * 0.55) * 1em + 0.8em, height: 0.9em, baseline: 0.15em,
    stroke: (bottom: 0.6pt + ink))
}

/// `n` ruled answer lines.
#let write-lines(n) = {
  for _ in range(n) {
    v(6.8mm, weak: false)
    line(length: 100%, stroke: 0.45pt + rule-c.darken(15%))
  }
  v(1mm)
}

#let qr-placeholder(url, size: 22mm) = box(width: size, height: size, stroke: (dash: "dashed", paint: muted, thickness: 0.6pt), radius: 2pt,
  align(center + horizon, text(font: sans, size: 6pt, fill: muted)[QR code\ #text(size: 5pt, url)]))

// ---------------------------------------------------------------------------------------------
// Page setup
// ---------------------------------------------------------------------------------------------

#let book(title: "", subtitle: "", kind: "book", version: "", paper: "a4", app-url: "", draft: false, body) = {
  set document(title: title + if kind == "key" { " – Answer key" } else { "" }, author: "Doppelpunkt")
  set page(
    paper: paper,
    margin: if paper == "a4" { (inside: 22mm, outside: 18mm, top: 20mm, bottom: 20mm) } else { (inside: 18mm, outside: 14mm, top: 17mm, bottom: 18mm) },
    header: context {
      let p = here().page()
      let starts = query(heading.where(level: 2).or(heading.where(level: 1))).filter(h => h.location().page() == p)
      if p > 2 and starts.len() == 0 {
        let prev = query(selector(heading.where(level: 2)).before(here()))
        if prev.len() > 0 {
          set text(font: sans, size: 7pt, fill: muted)
          grid(columns: (1fr, auto), title + if kind == "key" [ · Answer key], prev.last().body)
          v(-1mm)
          line(length: 100%, stroke: 0.4pt + rule-c)
        }
      }
    },
    footer: context {
      let p = here().page()
      if p > 1 {
        set text(font: sans, size: 7.5pt, fill: muted)
        let n = counter(page).display()
        if calc.even(p) { grid(columns: (auto, 1fr), n, align(right, if draft [Draft · v#version] else [v#version])) }
        else { grid(columns: (1fr, auto), if draft [Draft · v#version] else [v#version], n) }
      }
    },
  )
  set text(font: serif, size: if paper == "a4" { 10.2pt } else { 9.6pt }, lang: "en", fill: ink)
  set par(justify: true, leading: 0.62em, spacing: 0.9em)
  set list(indent: 0.6em, body-indent: 0.5em, marker: text(fill: gold, [•]))
  set table(stroke: 0.4pt + rule-c, inset: (x: 4pt, y: 3.2pt))
  show table.cell.where(y: 0): set text(font: sans, size: 0.82em, weight: "bold")
  set outline(indent: auto)
  show outline.entry.where(level: 1): it => { v(0.8em, weak: true); strong(it) }

  show heading: set text(font: sans, fill: ink)
  show heading.where(level: 1): it => {
    pagebreak(weak: true)
    v(30%)
    block(text(size: 9pt, weight: "bold", fill: gold, tracking: 1.5pt, upper(it.supplement + " ")))
    text(size: 30pt, weight: "bold", it.body)
    v(4mm)
    line(length: 30mm, stroke: 2.5pt + gold)
    pagebreak()
  }
  show heading.where(level: 2): it => {
    if kind != "key" { pagebreak(weak: true) } else { v(4mm, weak: true) }
    block(below: 4mm, text(size: 19pt, weight: "bold", it.body))
  }
  show heading.where(level: 3): it => block(above: 6mm, below: 3mm, sticky: true,
    grid(columns: (3pt, 1fr), column-gutter: 5pt, rect(width: 3pt, height: 1.1em, fill: gold, radius: 1pt),
      text(size: 11.5pt, weight: "bold", it.body)))
  show heading.where(level: 4): it => block(above: 4.5mm, below: 2.2mm, sticky: true, text(size: 10pt, weight: "bold", fill: gold-strong, it.body))
  body
}

#let part(title, label: "Part") = heading(level: 1, supplement: [#label], title)

// ---------------------------------------------------------------------------------------------
// Front matter
// ---------------------------------------------------------------------------------------------

#let title-page(title: "", subtitle: "", levels: "", kind: "book", version: "", app-url: "", draft: false, stats: none) = page(margin: 20mm, header: none, footer: none, {
  set text(font: sans)
  v(18mm)
  grid(columns: (auto, auto), column-gutter: 3mm,
    text(size: 46pt, weight: "black", title.split(":").at(0)),
    stack(spacing: 7pt, v(10pt), circle(radius: 5pt, fill: gold), circle(radius: 5pt, fill: swiss)))
  v(2mm)
  text(size: 26pt, weight: "bold", fill: muted, subtitle)
  v(6mm)
  box(inset: (x: 6pt, y: 3pt), radius: 3pt, fill: gold-soft, text(size: 11pt, weight: "bold", fill: gold-strong, levels))
  h(2mm)
  if kind == "key" { box(inset: (x: 6pt, y: 3pt), radius: 3pt, fill: ink, text(size: 11pt, weight: "bold", fill: white, "Answer key")) }
  v(8mm)
  text(size: 12pt)[German for English speakers – Standard German with a Swiss German lane]
  v(1fr)
  grid(columns: (1fr, auto), align: (left + bottom, right + bottom),
    {
      set text(size: 8.5pt, fill: muted)
      if stats != none [#stats \ ]
      [Version #version#if draft [ · draft, native review pending] \ ]
      [Free PDF. Audio, instant checking and the AI tutors are in the app: \ ]
      link(app-url, text(fill: ink, weight: "bold", app-url))
    },
    qr-placeholder(app-url, size: 26mm))
})

#let legend() = {
  grid(columns: (auto, 1fr), column-gutter: 6pt, row-gutter: 5pt,
    vtag("de"), [Standard German as spoken in Germany (gold, like in the app).],
    vtag("ch-std"), [Swiss Standard German: Standard German with Swiss spelling (ss, never ß) and Helvetisms.],
    vtag("gsw-zh"), [Zurich German (Züritüütsch), the course's Swiss dialect (red).],
    vtag("gsw-be"), [Bernese German (Bärndütsch), for recognition only at A1–A2.],
    track("A1.01.03"), [Audio track. Play it in the app (unit page or the track list in the appendix). Transcripts are in the answer key.],
  )
  v(1mm)
  [Nouns: #text(fill: gender-c.m, weight: "bold")[der] masculine · #text(fill: gender-c.f, weight: "bold")[die] feminine · #text(fill: gender-c.n, weight: "bold")[das] neuter. Plural “–” means the noun has no plural.]
}

// ---------------------------------------------------------------------------------------------
// Unit pieces
// ---------------------------------------------------------------------------------------------

#let unit-opener(level: "", number: 0, unit-id: "", title: [], title-en: [], goal: [], can-do: (), url: "") = {
  heading(level: 2, [#level · #number #h(0.4em) #title])
  grid(columns: (1fr, auto), column-gutter: 5mm,
    {
      text(font: sans, size: 11pt, fill: muted, title-en)
      v(3mm)
      block(inset: (left: 7pt, y: 5pt), stroke: (left: 2.5pt + gold), [
        #text(font: sans, size: 8pt, weight: "bold", fill: gold-strong, tracking: 0.8pt)[GOAL] \
        #goal
      ])
      v(1.5mm)
      text(font: sans, size: 8pt, weight: "bold", fill: gold-strong, tracking: 0.8pt)[CAN DO]
      v(-1mm)
      for c in can-do { block(above: 1.6mm, below: 0mm, grid(columns: (10pt, 1fr), checkbox, c)) }
    },
    align(center, { qr-placeholder(url, size: 20mm); v(1mm); text(font: sans, size: 6pt, fill: muted, unit-id) }))
}

#let scene(body) = block(above: 2mm, below: 3mm, text(style: "italic", fill: muted, body))

/// Dialogue: rows of (speaker, variety, german, english).
#let dialogue(rows, track-id: none) = {
  if track-id != none { block(below: 2mm, track(track-id)) }
  grid(columns: (auto, 1fr, 0.82fr), column-gutter: 3.5mm, row-gutter: 2.4mm,
    ..rows.map(r => (
      text(font: sans, size: 0.8em, weight: "bold", r.at(0)),
      de(r.at(1), r.at(2)),
      text(size: 0.92em, en(r.at(3))),
    )).flatten())
}

#let grammar-point(title, body) = {
  heading(level: 4, title)
  body
}

#let gtable(cols, ..cells) = block(above: 2.5mm, below: 2.5mm, table(columns: cols, fill: (_, y) => if y == 0 { gold-soft } else { none }, ..cells))

#let mistakes(items) = block(above: 2.5mm, below: 3mm, inset: 6pt, radius: 2pt, fill: paper-tint, width: 100%, {
  text(font: sans, size: 7.5pt, weight: "bold", fill: muted, tracking: 0.8pt)[COMMON MISTAKES]
  for m in items { block(above: 1.8mm, below: 0mm, grid(columns: (9pt, 1fr), text(fill: swiss, weight: "bold", "✗"), m)) }
})

/// Vocabulary: rows of (german, gender or none, plural, english, swiss, example) – each content or none.
#let vocab-table(rows) = table(
  columns: (1.25fr, 0.62fr, 1fr, 1.2fr),
  stroke: (x, y) => (bottom: 0.4pt + rule-c),
  inset: (x: 3pt, y: 3pt),
  table.header([German], [Plural], [English], [Swiss]),
  ..rows.map(r => {
    let g = r.at(1)
    (
      {
        if g != none { text(font: sans, size: 0.78em, weight: "bold", fill: gender-c.at(g), article.at(g)); h(2.5pt) }
        text(lang: "de", weight: "bold", r.at(0))
        if r.at(5) != none { linebreak(); text(size: 0.82em, fill: muted, lang: "de", r.at(5)) }
      },
      text(lang: "de", size: 0.92em, if r.at(2) != none { r.at(2) } else { [] }),
      text(size: 0.92em, r.at(3)),
      text(size: 0.88em, if r.at(4) != none { r.at(4) } else { [] }),
    )
  }).flatten(),
)

#let reading(title, body) = block(inset: 9pt, radius: 2pt, stroke: 0.5pt + rule-c, width: 100%, {
  text(font: sans, weight: "bold", lang: "de", title)
  v(1mm)
  body
})

/// The Swiss lane: same situation in dialect. Red accent, like the app.
#let swiss-lane(title, body) = {
  block(above: 7mm, below: 3mm, sticky: true, grid(columns: (3pt, 1fr), column-gutter: 5pt,
    rect(width: 3pt, height: 1.1em, fill: swiss, radius: 1pt),
    text(font: sans, size: 11.5pt, weight: "bold", fill: swiss-strong, title)))
  block(inset: (left: 9pt, right: 6pt, y: 7pt), stroke: (left: 2pt + swiss), fill: swiss-soft.lighten(55%), width: 100%, body)
}

#let notes(items, color: swiss) = block(above: 2mm, below: 3mm, stack(spacing: 1.8mm, ..items.map(n => grid(columns: (9pt, 1fr), text(fill: color, weight: "bold", "›"), n))))

// ---------------------------------------------------------------------------------------------
// Exercises
// ---------------------------------------------------------------------------------------------

#let skill-label = (reading: "Reading", listening: "Listening", speaking: "Speaking", writing: "Writing", vocabulary: "Vocabulary", grammar: "Grammar")

/// One exercise: number, kind, skill, variety, English prompt, optional track; body = the task.
#let exercise(n, kind: "", skill: "", variety: "de", prompt: [], track-id: none, body) = block(above: 4.2mm, below: 0mm, breakable: true, width: 100%, {
  block(sticky: true, below: 1.6mm, grid(columns: (auto, 1fr, auto), column-gutter: 5pt, align: (left + horizon, left + horizon, right + horizon),
    box(inset: (x: 3pt, y: 2pt), radius: 2pt, fill: accent(variety), text(font: sans, size: 7.5pt, weight: "bold", fill: white, n)),
    { strong(prompt); if track-id != none { h(4pt); track(track-id) } },
    { text(font: sans, size: 6pt, fill: muted, upper(skill-label.at(skill)) + " · " + kind); h(3pt); vtag(variety) }))
  pad(left: 4mm, body)
})

#let options(items) = {
  let letters = "abcdefghij"
  let long = items.any(i => repr(i).len() > 120)
  grid(columns: if long or items.len() > 4 { 1 } else { items.len() }, column-gutter: 6mm, row-gutter: 2mm,
    ..items.enumerate().map(((i, it)) => box[#circle-box #h(2pt) #text(font: sans, size: 0.85em, weight: "bold", letters.at(i) + ")") #h(2pt) #it]))
}

#let tokens(items) = {
  set text(lang: "de")
  items.map(t => box(inset: (x: 4pt, y: 2.2pt), radius: 2pt, stroke: 0.5pt + muted, t)).join(h(4pt))
}

/// Matching: left items numbered, right items lettered (already shuffled).
#let match-cols(left, right) = {
  let letters = "abcdefghijklmnopqrstuvwxyz"
  grid(columns: (1fr, 1fr), column-gutter: 6mm,
    grid(columns: (auto, 1fr, auto), column-gutter: 4pt, row-gutter: 2.4mm,
      ..left.enumerate().map(((i, it)) => (text(font: sans, size: 0.85em, weight: "bold", str(i + 1)), it, box(width: 7mm, height: 0.9em, stroke: (bottom: 0.6pt + ink)))).flatten()),
    grid(columns: (auto, 1fr), column-gutter: 4pt, row-gutter: 2.4mm,
      ..right.enumerate().map(((i, it)) => (text(font: sans, size: 0.85em, weight: "bold", letters.at(i) + ")"), it)).flatten()))
}

#let task-box(body) = block(inset: 6pt, radius: 2pt, fill: paper-tint, width: 100%, body)
#let goals(items) = block(above: 1.6mm, below: 2mm, stack(spacing: 1.5mm, ..items.map(g => grid(columns: (10pt, 1fr), checkbox, g))))
#let app-note(body) = block(above: 1.8mm, text(font: sans, size: 7pt, fill: muted, body))

// ---------------------------------------------------------------------------------------------
// Answer key
// ---------------------------------------------------------------------------------------------

#let key-item(n, variety: "de", kind: "", answer, explanation) = block(above: 2.6mm, below: 0mm, breakable: true,
  grid(columns: (11mm, 1fr), column-gutter: 2mm,
    box(inset: (x: 2.5pt, y: 1.6pt), radius: 2pt, fill: accent(variety), text(font: sans, size: 7pt, weight: "bold", fill: white, n)),
    {
      answer
      if explanation != [] { block(above: 1.2mm, below: 0mm, text(size: 0.9em, fill: muted, explanation)) }
    }))

#let also(body) = text(size: 0.85em, fill: muted)[ (also accepted: #body)]
#let transcript(body) = block(above: 1.4mm, below: 0mm, inset: (left: 6pt, y: 3pt), stroke: (left: 1.2pt + rule-c), text(size: 0.92em, body))
#let model(body) = block(above: 1.4mm, below: 0mm, inset: 5pt, radius: 2pt, fill: paper-tint, width: 100%, text(lang: "de", body))

/// Track list row: (id, where, file).
#let track-list(rows) = table(columns: (auto, 1fr, auto), stroke: (x, y) => (bottom: 0.3pt + rule-c), inset: (x: 3pt, y: 2pt),
  table.header([Track], [Content], [File in the app]),
  ..rows.map(r => (text(font: sans, size: 0.8em, weight: "bold", r.at(0)), text(size: 0.85em, r.at(1)), text(font: "DejaVu Sans Mono", size: 0.62em, r.at(2)))).flatten())
